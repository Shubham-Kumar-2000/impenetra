{
  "rest": {
    "RestGenerator": {
      "name": "Impenetra-FastAPI-Chat",
      "uri": "http://127.0.0.1:8000/chat",
      "method": "post",
      "headers": {
        "Content-Type": "application/json"
      },
      "req_template_json_object": {
        "prompt": "$INPUT"
      },
      "response_json": true,
      "response_json_field": "$.response"
    }
  }
}
