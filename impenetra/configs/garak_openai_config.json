{
  "rest": {
    "RestGenerator": {
      "name": "Impenetra-FastAPI-OpenAI",
      "uri": "http://127.0.0.1:8000/v1/chat/completions",
      "method": "post",
      "headers": {
        "Content-Type": "application/json"
      },
      "req_template_json_object": {
        "model": "impenetra-guardrail",
        "messages": [
          {
            "role": "user",
            "content": "$INPUT"
          }
        ]
      },
      "response_json": true,
      "response_json_field": "$.choices[0].message.content"
    }
  }
}
